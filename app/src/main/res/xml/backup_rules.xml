<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Back up user data (jazzy.db) only; never the TMDB cache DB or torrent data. -->
<full-backup-content>
    <include domain="database" path="jazzy.db" />
    <include domain="database" path="jazzy.db-wal" />
    <include domain="database" path="jazzy.db-shm" />
</full-backup-content>
