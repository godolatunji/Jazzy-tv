<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Back up user data (jazzy.db) only; never the TMDB cache DB or torrent data. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="jazzy.db" />
        <include domain="database" path="jazzy.db-wal" />
        <include domain="database" path="jazzy.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="jazzy.db" />
        <include domain="database" path="jazzy.db-wal" />
        <include domain="database" path="jazzy.db-shm" />
    </device-transfer>
</data-extraction-rules>
