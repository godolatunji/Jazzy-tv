    <!-- About -->
    <string name="settings_about_title">About</string>
    <string name="settings_about_brand" translatable="false">JAZZY</string>
    <string name="settings_about_version">Version %1$s</string>
    <string name="settings_about_version_unknown">Unknown</string>
    <string name="settings_about_tmdb_wordmark" translatable="false">TMDB</string>
    <string name="settings_about_tmdb_attribution">This product uses the TMDB API but is not endorsed or certified by TMDB.</string>
    <string name="settings_about_tmdb_detail">Film and TV information and artwork come from The Movie Database (themoviedb.org).</string>
    <string name="settings_about_disclaimer_title">Disclaimer</string>
    <string name="settings_about_disclaimer">Jazzy doesn\'t host, upload or store any films or TV shows. It searches third-party torrent sites and streams the file you choose directly from other people\'s computers (peer to peer), which also shares pieces of that file with them while you watch. You are responsible for what you search for, stream and share, and for following the copyright law where you live. Only watch content you have the right to watch.</string>
    <string name="settings_about_privacy_title">Privacy</string>
    <string name="settings_about_privacy">Jazzy has no account and no servers. Profiles, play history, likes, My List, search history and recommendations are stored only in a local database on this device and never leave it. TMDB receives the look-ups needed to show title information, torrent sites receive the searches Jazzy runs for you, and other peers in a torrent swarm can see your IP address. Crash reports and usage metrics stay off unless you turn them on in Settings → Privacy.</string>
